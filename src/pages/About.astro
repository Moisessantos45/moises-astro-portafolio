---
import Footer from "@/components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import SkillBadge from "../components/SkillBadge.astro";
import Contact from "@/components/section/Contact.vue";
import { skills } from "@skills";
import { URL_CV } from "astro:env/client";

interface Skill {
  skill: string;
  icon: string;
  category: string;
}

const allSkills: Skill[] = skills;

const skillCategories = [
  { key: "Frontend",         label: "Frontend" },
  { key: "Backend",          label: "Backend" },
  { key: "Databases",        label: "Bases de datos" },
  { key: "Mobile & Desktop", label: "Mobile & Desktop" },
  { key: "Tools",            label: "Herramientas" },
];

const skillsByCategory = skillCategories.map(({ key, label }) => ({
  label,
  items: allSkills.filter((s) => s.category === key),
}));

const birthDate = new Date("2001-11-13");
const today = new Date();
const age = Math.floor(
  (today.getTime() - birthDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25),
);

const startDate = new Date("2022-08-01");
const monthsDiff =
  (today.getFullYear() - startDate.getFullYear()) * 12 +
  (today.getMonth() - startDate.getMonth());
const semester = Math.min(Math.ceil(monthsDiff / 6), 10);
---

<Layout title="Sobre mí — Moisés Santos | Desarrollador Full Stack">
  <main>
    <div class="section-max pt-14 pb-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 mb-12 font-body text-sm text-(--color-ink-muted) hover:text-(--color-ink) transition-colors duration-200"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        Volver al inicio
      </a>

      <header
        class="flex flex-col lg:flex-row items-center lg:items-start gap-12 mb-20 scroll-reveal"
      >
        <div class="relative w-44 h-44 group shrink-0">
          <div
            class="absolute inset-0 rounded-2xl bg-(--color-surface-alt) translate-x-2.5 translate-y-2.5 transition-transform duration-500 group-hover:translate-x-4 group-hover:translate-y-4"
          >
          </div>
          <div
            class="relative w-full h-full rounded-2xl overflow-hidden border border-(--color-border-mid) bg-white"
          >
            <img
              src="https://res.cloudinary.com/dtkskpitc/image/upload/f_webp,q_auto/v1723951107/cv-proyects/niwkkte9km7amzss4hwb"
              alt="Moises Santos"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          </div>
        </div>

        <div class="text-center lg:text-left flex-1 space-y-5">
          <div>
            <p class="label-tag mb-2">
              Desarrollador Full Stack &bull; Freelance &bull; UASLP
            </p>
            <h1
              class="font-display text-5xl sm:text-6xl text-(--color-ink) leading-[1.05]"
            >
              Moises Santos
            </h1>
          </div>

          <div class="flex flex-wrap justify-center lg:justify-start gap-2">
            <span
              class="inline-flex items-center gap-1.5 font-body text-xs font-medium px-3 py-1.5 rounded-md bg--white border border-(--color-border-mid) text-(--color-ink-soft)"
            >
              <span class="status-dot-active"></span>
              Disponible para proyectos
            </span>
            <span
              class="inline-flex items-center gap-1.5 font-body text-xs font-medium px-3 py-1.5 rounded-md bg--white border border-(--color-border-mid) text-(--color-ink-soft)"
            >
              📍 San Luis Potosí, México
            </span>
          </div>

          <div
            class="flex flex-wrap justify-center lg:justify-start items-center gap-3 pt-1"
          >
            <a
              href="https://github.com/Moisessantos45"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-lg flex items-center justify-center border border-(--color-border-mid) bg--white text-(--color-ink-soft) hover:text-(--color-ink) hover:border-[rgba(24,24,27,0.22)] transition-all duration-200"
              aria-label="GitHub"
            >
              <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                ></path>
              </svg>
            </a>

            <a
              href="https://www.linkedin.com/in/moises-santos-hern%C3%A1ndez-31192b290/"
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-lg flex items-center justify-center border border-(--color-border-mid) bg--white text-(--color-ink-soft) hover:text-(--color-ink) hover:border-[rgba(24,24,27,0.22)] transition-all duration-200"
              aria-label="LinkedIn"
            >
              <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                ></path>
              </svg>
            </a>

            <a
              href={URL_CV}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary py-2.5 px-5 text-sm group"
              title="Descargar Curriculum Vitae"
            >
              <svg
                class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path>
              </svg>
              Descargar CV
            </a>
          </div>
        </div>
      </header>

      <div class="grid md:grid-cols-2 gap-6 mb-20 scroll-reveal">
        <article class="portfolio-card p-8">
          <h3 class="font-display text-2xl text-(--color-ink) mb-4">
            ¿Quién soy?
          </h3>
          <p class="font-body text-sm leading-relaxed text-(--color-ink-soft)">
            Soy <strong class="font-semibold text-(--color-ink)">Moisés Santos</strong>, desarrollador de software con casi 4 años ayudando a negocios y emprendedores a convertir procesos manuales en herramientas digitales más rápidas y fáciles de usar. También soy estudiante del último tramo de Ingeniería en Sistemas Inteligentes en la UASLP, aunque lo que más me ha formado es el trabajo real con clientes.
          </p>
        </article>

        <article class="portfolio-card p-8">
          <h3 class="font-display text-2xl text-(--color-ink) mb-4">
            Lo que he construido
          </h3>
          <p class="font-body text-sm leading-relaxed text-(--color-ink-soft)">
            He desarrollado sistemas para <strong class="font-semibold text-(--color-ink)">control de inventario</strong>, <strong class="font-semibold text-(--color-ink)">registro de accesos</strong>, <strong class="font-semibold text-(--color-ink)">gestión de cobros</strong>, tiendas en línea y plataformas de administración interna. Cada proyecto lo llevo de inicio a fin: desde entender el problema hasta entregar algo funcionando y listo para usar.
          </p>
        </article>

        <article class="portfolio-card p-8 md:col-span-2">
          <h3 class="font-display text-2xl text-(--color-ink) mb-4">
            Cómo trabajo
          </h3>
          <p class="font-body text-sm leading-relaxed text-(--color-ink-soft)">
            Antes de escribir una sola línea de código, busco entender bien el problema. Me importa que lo que entrego sea <strong class="font-semibold text-(--color-ink)">claro, estable y fácil de mantener a largo plazo</strong>. No solo que funcione el día de entrega, sino que siga siendo útil semanas y meses después. Si trabajamos juntos, te explico cada paso en lenguaje simple.
          </p>
        </article>
      </div>

      <div class="flex justify-center mb-24 scroll-reveal">
        <a href="/Projects" class="btn-primary">
          Explorar Proyectos
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>

    <section class="border-t border-(--color-border) py-20 scroll-reveal">
      <div class="section-max">
        <div class="mb-14">
          <p class="label-tag mb-2">Stack tecnológico</p>
          <h2
            class="font-display text-4xl sm:text-5xl text-(--color-ink) leading-tight"
          >
            Habilidades técnicas
          </h2>
        </div>

        <div class="space-y-10">
          {
            skillsByCategory.map(({ label, items }) =>
              items.length > 0 ? (
                <div class="skills-group">
                  <p class="label-tag mb-4">{label}</p>
                  <div class="flex flex-wrap gap-2">
                    {items.map((item) => (
                      <SkillBadge skill={item.skill} icon={item.icon} />
                    ))}
                  </div>
                </div>
              ) : null
            )
          }
        </div>
      </div>
    </section>

    <Contact client:visible />
  </main>
  <Footer />
</Layout>
