---
import api from "@/api/config";
import type { Stream } from "@/types/stream";
import Layout from "../layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { mapperStream } from "@/helpers/mappers/stream";

const getDemoList = async (): Promise<Stream[]> => {
  try {
    const { data } = await api.get("/stream");

    const newData = data["data"]["data"] ?? [];

    const dataProjects = newData.map(mapperStream);
    return dataProjects;
  } catch (error) {
    return [];
  }
};

const data: Stream[] = await getDemoList().then((res) => res);

const getYouTubeId = (url: string): string => {
  const regExp =
    /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=|shorts\/)([^#&?]*).*/;
  const match = url.match(regExp);
  return match && match[2].length === 11 ? match[2] : "";
};
---

<Layout title="Video Demos | Moises Santos">
  <main class="min-h-screen">
    <section class="mx-auto max-w-5xl px-6 lg:px-0 py-20">
      <div class="text-center mb-16">
        <span class="font-label text-xs font-semibold tracking-wider text-(--color-secondary) uppercase mb-2 block">
          Demostraciones Prácticas
        </span>
        <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4 tracking-tight text-(--color-primary)">
          Video Demos
        </h1>
        <p class="font-body text-base max-w-2xl mx-auto text-(--color-secondary)" style="line-height: 1.6;">
          Explora demostraciones interactivas y proyectos grabados en video que demuestran el funcionamiento real de las tecnologías y soluciones de software.
        </p>
      </div>

      {
        data.length === 0 ? (
          <div class="text-center py-20 scroll-reveal">
            <div class="arctic-card max-w-md mx-auto text-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-16 h-16 mx-auto mb-6 text-(--color-secondary)"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                />
              </svg>
              <h3 class="text-xl font-bold mb-2 tracking-tight text-(--color-primary)">
                No hay demos disponibles
              </h3>
              <p class="text-sm font-body text-(--color-secondary)">
                Próximamente se añadirán nuevos videos y grabaciones explicativas de demostración.
              </p>
            </div>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {data
              .filter((demo) => demo.status)
              .map((demo) => {
                const videoId = getYouTubeId(demo.url);
                return (
                  <article class="arctic-card flex flex-col h-full scroll-reveal">
                    <!-- Video Embed inside rounded-sm block -->
                    <div class="aspect-video mb-6 rounded-md overflow-hidden bg-(--color-neutral) border border-[rgba(98,122,139,0.1)] relative">
                      {videoId ? (
                        <lite-youtube
                          videoid={videoId}
                          style="background-image: url(https://i.ytimg.com/vi/{videoId}/hqdefault.jpg);"
                          class="w-full h-full"
                        >
                          <div slot="playButton" class="lty-playbtn">
                            <svg
                              height="100%"
                              version="1.1"
                              viewBox="0 0 68 48"
                              width="100%"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path
                                class="lty-large-play-button-bg"
                                d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"
                                fill="var(--color-tertiary)"
                              />
                              <path d="M 45,24 27,14 27,34" fill="#fff" />
                            </svg>
                          </div>
                        </lite-youtube>
                      ) : (
                        <div class="w-full h-full flex items-center justify-center">
                          <div class="text-center p-4">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="w-10 h-10 mx-auto mb-2 text-(--color-secondary)"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"
                              />
                            </svg>
                            <p class="text-xs font-semibold text-(--color-secondary)">
                              Video no disponible
                            </p>
                          </div>
                        </div>
                      )}
                    </div>

                    <!-- Details content grow area -->
                    <div class="flex flex-col grow justify-between">
                      <div class="space-y-3">
                        <h3 class="text-lg font-bold tracking-tight text-(--color-primary)">
                          {demo.title}
                        </h3>

                        {demo.description && (
                          <p class="text-sm font-body leading-relaxed line-clamp-3 text-(--color-secondary)">
                            {demo.description}
                          </p>
                        )}
                      </div>

                      <div class="flex items-center justify-between pt-6 mt-6 border-t border-[rgba(98,122,139,0.1)]">
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                          <span class="text-xs font-semibold text-(--color-secondary)">
                            Disponible
                          </span>
                        </div>

                        {videoId && (
                          <a
                            href={demo.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold rounded-sm transition-opacity cursor-pointer text-(--color-on-primary) bg-(--color-tertiary)"
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="w-3.5 h-3.5"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                              />
                            </svg>
                            Ver en YouTube
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import "@justinribeiro/lite-youtube";
</script>

<style>
  lite-youtube {
    background-color: var(--color-neutral);
    border-radius: var(--radius-sm);
  }

  lite-youtube::before {
    content: "";
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68px;
    height: 48px;
    margin-left: -34px;
    margin-top: -24px;
    background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 68 48"><path fill="%232563EB" d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z"/><path d="M 45,24 27,14 27,34" fill="%23fff"/></svg>')
      no-repeat center;
    background-size: contain;
    transition: opacity 0.3s;
  }

  lite-youtube:hover::before {
    opacity: 0.8;
  }
</style>
