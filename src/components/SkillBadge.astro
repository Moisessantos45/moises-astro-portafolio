---
import fs from "node:fs";
import path from "node:path";

interface Props {
  skill: string;
  icon: string;
}

const { skill, icon } = Astro.props;

const isImg = icon.endsWith(".png");
let svgContent: string | null = null;

if (!isImg) {
  const publicDir = path.join(process.cwd(), "public");
  const filePath = path.join(publicDir, icon);
  try {
    const raw = fs.readFileSync(filePath, "utf-8");
    const cleaned = raw
      .replace(/<\?xml[^>]*\?>/g, "")
      .replace(/<!--[\s\S]*?-->/g, "")
      .replace(/width="[^"]*"/, 'width="18"')
      .replace(/height="[^"]*"/, 'height="18"')
      .replace(/class="[^"]*"/, "")
      .trim();
    svgContent = cleaned.startsWith("<svg") ? cleaned : null;
  } catch {
    svgContent = null;
  }
}
---

<span
  class="skill-chip group inline-flex items-center gap-2 font-body text-xs font-medium px-3 py-1.5 rounded-md bg-(--color-white) border border-(--color-border) text-(--color-ink-soft) hover:border-(--color-border-mid) hover:text-(--color-ink) transition-all duration-200 cursor-default"
>
  {
    isImg || !svgContent ? (
      <img
        src={icon}
        alt=""
        class="w-4 h-4 object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-200"
      />
    ) : (
      <span
        class="skill-icon w-[18px] h-[18px] flex items-center justify-center shrink-0 text-(--color-ink-muted) group-hover:text-(--color-ink) transition-colors duration-200"
        set:html={svgContent}
      />
    )
  }
  {skill}
</span>
